{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://livepokertrainer.local/schemas/course/v2/lesson.schema.json",
  "title": "Course lesson node",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "order", "title", "summary", "objectives", "prerequisites", "remediationLessonIds", "estimatedMinutes", "difficultyBand", "playerTypeRefs", "activities"],
  "properties": {
    "id": { "$ref": "common.schema.json#/definitions/idString" },
    "order": { "$ref": "common.schema.json#/definitions/positiveInt" },
    "title": { "$ref": "common.schema.json#/definitions/nonEmptyString" },
    "summary": { "$ref": "common.schema.json#/definitions/nonEmptyString" },
    "objectives": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/definitions/nonEmptyString" }, "uniqueItems": true },
    "prerequisites": { "type": "array", "items": { "$ref": "common.schema.json#/definitions/idString" }, "uniqueItems": true },
    "remediationLessonIds": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/definitions/idString" }, "uniqueItems": true },
    "estimatedMinutes": { "$ref": "common.schema.json#/definitions/positiveInt" },
    "difficultyBand": { "$ref": "common.schema.json#/definitions/difficultyBand" },
    "playerTypeRefs": { "type": "array", "items": { "$ref": "common.schema.json#/definitions/playerTypeId" }, "uniqueItems": true },
    "introducesPlayerTypes": { "type": "array", "items": { "$ref": "common.schema.json#/definitions/playerTypeId" }, "uniqueItems": true },
    "activities": { "type": "array", "minItems": 1, "items": { "$ref": "activity.schema.json" } }
  }
}
