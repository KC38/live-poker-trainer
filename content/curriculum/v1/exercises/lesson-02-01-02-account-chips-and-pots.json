{
  "id": "lesson-02-01-02-account-chips-and-pots",
  "lessonId": "lesson-02-01-02-account-chips-and-pots",
  "version": "1.0.0",
  "title": "Account chips and pots",
  "questions": [
    {
      "id": "q1",
      "prompt": "$2/$5. Both blinds fold after you open to $15 and the button calls $15. Pot going to the flop is\u2026",
      "choices": [
        {
          "id": "a",
          "text": "$32: the $2, the $5, your $15, and the button's $15."
        },
        {
          "id": "b",
          "text": "$15."
        },
        {
          "id": "c",
          "text": "$30, ignoring blinds."
        },
        {
          "id": "d",
          "text": "$5."
        }
      ],
      "correctChoiceId": "a",
      "explanation": "Posted blinds stay in the pot even when those players fold."
    },
    {
      "id": "q2",
      "prompt": "If you lose the count, the reliable fix is\u2026",
      "choices": [
        {
          "id": "a",
          "text": "Guess from chip height."
        },
        {
          "id": "b",
          "text": "Ask the dealer to count the pot."
        },
        {
          "id": "c",
          "text": "Let the bettor announce a number and ship it."
        },
        {
          "id": "d",
          "text": "Add only the last bet."
        }
      ],
      "correctChoiceId": "b",
      "explanation": "A dealer count is a normal request before a big decision."
    },
    {
      "id": "q3",
      "prompt": "Hero shoves $90 into $30 and a covering player calls $90. Pot at showdown is\u2026",
      "choices": [
        {
          "id": "a",
          "text": "$90."
        },
        {
          "id": "b",
          "text": "$30."
        },
        {
          "id": "c",
          "text": "$210."
        },
        {
          "id": "d",
          "text": "$120."
        }
      ],
      "correctChoiceId": "c",
      "explanation": "30 + 90 + 90 = 210."
    },
    {
      "id": "q4",
      "prompt": "A half-pot bet into $60 is\u2026",
      "choices": [
        {
          "id": "a",
          "text": "$60."
        },
        {
          "id": "b",
          "text": "$15."
        },
        {
          "id": "c",
          "text": "$120."
        },
        {
          "id": "d",
          "text": "$30."
        }
      ],
      "correctChoiceId": "d",
      "explanation": "Half of 60 is 30."
    }
  ]
}
