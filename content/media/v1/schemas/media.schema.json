{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://livepokertrainer.local/schemas/media/v1/media.schema.json",
  "title": "MediaEntry",
  "description": "Versioned media asset entry for learning-platform and shell surfaces.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "semanticRole",
    "usageIds",
    "source",
    "provenanceId",
    "licenseId",
    "variants",
    "accessibility",
    "version",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^media\\.[a-z0-9]+(\\.[a-z0-9_-]+)+$",
      "description": "Stable media ID, e.g. media.image.coach.meridian.idle."
    },
    "kind": {
      "type": "string",
      "enum": ["image", "vector", "animation", "narration", "music", "sfx"]
    },
    "semanticRole": {
      "type": "string",
      "enum": ["decorative", "instructional", "control_feedback"]
    },
    "characterId": {
      "type": "string",
      "minLength": 1,
      "description": "Optional cast member this asset depicts or voices."
    },
    "usageIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Surfaces or lesson slots that may reference this asset."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system"],
      "properties": {
        "system": {
          "type": "string",
          "minLength": 1,
          "description": "Origin system, e.g. figma, repo, elevenlabs, internal."
        },
        "fileKey": {
          "type": "string",
          "minLength": 1
        },
        "nodeId": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Repo-relative path when the source is checked in."
        }
      }
    },
    "provenanceId": {
      "type": "string",
      "minLength": 1
    },
    "licenseId": {
      "type": "string",
      "minLength": 1
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["locale", "theme", "motion", "uri"],
        "properties": {
          "locale": {
            "type": "string",
            "minLength": 2,
            "description": "BCP 47 locale, e.g. en, en-US."
          },
          "theme": {
            "type": "string",
            "minLength": 1,
            "description": "Visual/audio theme key, e.g. dark_felt."
          },
          "motion": {
            "type": "string",
            "enum": ["none", "subtle", "full"],
            "description": "Motion preference variant this URI satisfies."
          },
          "uri": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "dimensions": {
            "type": "object",
            "additionalProperties": false,
            "required": ["width", "height"],
            "properties": {
              "width": { "type": "integer", "minimum": 1 },
              "height": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decorative"],
      "properties": {
        "decorative": {
          "type": "boolean"
        },
        "altMessageId": {
          "type": "string",
          "minLength": 1
        },
        "longDescriptionMessageId": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "decorative": { "const": false } },
            "required": ["decorative"]
          },
          "then": {
            "required": ["altMessageId"]
          }
        }
      ]
    },
    "fallbackId": {
      "type": "string",
      "minLength": 1,
      "description": "Optional media ID to use when this entry fails to load."
    },
    "safeCrop": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "phone": {
          "$ref": "#/definitions/cropRect"
        },
        "tablet": {
          "$ref": "#/definitions/cropRect"
        }
      }
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": ["draft", "approved", "released", "retired"]
    },
    "approvals": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "status"],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1,
            "description": "Approver role, e.g. creative, accessibility, legal."
          },
          "status": {
            "type": "string",
            "enum": ["pending", "approved", "rejected"]
          },
          "by": {
            "type": "string",
            "minLength": 1
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  },
  "definitions": {
    "cropRect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "description": "Normalized safe-crop rectangle in 0..1 image space.",
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    }
  }
}
