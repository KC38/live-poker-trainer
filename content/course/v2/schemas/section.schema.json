{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://livepokertrainer.local/schemas/course/v2/section.schema.json",
  "title": "Course section and unit",
  "definitions": {
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "order", "title", "summary", "lessons"],
      "properties": {
        "id": { "$ref": "common.schema.json#/definitions/idString" },
        "order": { "$ref": "common.schema.json#/definitions/positiveInt" },
        "title": { "$ref": "common.schema.json#/definitions/nonEmptyString" },
        "summary": { "$ref": "common.schema.json#/definitions/nonEmptyString" },
        "lessons": { "type": "array", "minItems": 1, "items": { "$ref": "lesson.schema.json" } }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "order", "title", "summary", "experienceBand", "units"],
      "properties": {
        "id": { "$ref": "common.schema.json#/definitions/idString" },
        "order": { "$ref": "common.schema.json#/definitions/positiveInt" },
        "title": { "$ref": "common.schema.json#/definitions/nonEmptyString" },
        "summary": { "$ref": "common.schema.json#/definitions/nonEmptyString" },
        "experienceBand": { "$ref": "common.schema.json#/definitions/experienceBand" },
        "units": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/unit" } }
      }
    }
  }
}
