    {
      "id": "q3",
      "prompt": "On As 7d 2c, who usually has the range advantage in a single-raised pot?",
      "choices": [
        {
          "id": "a",
          "text": "The preflop raiser"
        },
        {
          "id": "b",
          "text": "The big blind caller"
        },
        {
          "id": "c",
          "text": "Whoever limped"
        },
        {
          "id": "d",
          "text": "The player with the smaller stack, always"
        }
