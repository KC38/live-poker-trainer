{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://livepokertrainer.local/schemas/curriculum/v1/curriculum.schema.json",
  "title": "Live Poker Trainer Curriculum Catalog",
  "description": "Versioned curriculum catalog for the learning platform (sections, units, lessons, objectives, milestone gates).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "catalogVersion",
    "minClientVersion",
    "sections",
    "objectives",
    "milestoneGates"
  ],
  "properties": {
    "catalogVersion": {
      "type": "string",
      "description": "Semantic version of this catalog document.",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "minClientVersion": {
      "type": "string",
      "description": "Minimum client app version that can consume this catalog.",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/section" }
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/objective" }
    },
    "milestoneGates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/milestoneGate" }
    }
  },
  "definitions": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "idString": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "positiveInt": {
      "type": "integer",
      "minimum": 1
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "order", "title", "summary", "units"],
      "properties": {
        "id": { "$ref": "#/definitions/idString" },
        "order": { "type": "integer", "minimum": 0 },
        "title": { "$ref": "#/definitions/nonEmptyString" },
        "summary": { "$ref": "#/definitions/nonEmptyString" },
        "milestoneGateId": { "$ref": "#/definitions/idString" },
        "units": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/unit" }
        }
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "order", "title", "summary", "objectiveIds", "lessons"],
      "properties": {
        "id": { "$ref": "#/definitions/idString" },
        "order": { "$ref": "#/definitions/positiveInt" },
        "title": { "$ref": "#/definitions/nonEmptyString" },
        "summary": { "$ref": "#/definitions/nonEmptyString" },
        "objectiveIds": {
          "type": "array",
          "items": { "$ref": "#/definitions/idString" },
          "uniqueItems": true
        },
        "lessons": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/lesson" }
        }
      }
    },
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "order",
        "title",
        "format",
        "objectiveIds",
        "estimatedMinutes",
        "mediaIds",
        "exerciseRefs",
        "simulationClaims",
        "prerequisites",
        "remediationLessonIds"
      ],
      "properties": {
        "id": { "$ref": "#/definitions/idString" },
        "order": { "$ref": "#/definitions/positiveInt" },
        "title": { "$ref": "#/definitions/nonEmptyString" },
        "format": {
          "type": "string",
          "enum": [
            "concept",
            "decision_drill",
            "worked_review",
            "scenario",
            "assessment",
            "hand_lab"
          ]
        },
        "objectiveIds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/idString" },
          "uniqueItems": true
        },
        "estimatedMinutes": {
          "type": "integer",
          "minimum": 1
        },
        "mediaIds": {
          "type": "array",
          "items": { "$ref": "#/definitions/idString" },
          "uniqueItems": true
        },
        "exerciseRefs": {
          "type": "array",
          "items": { "$ref": "#/definitions/nonEmptyString" },
          "uniqueItems": true
        },
        "simulationClaims": {
          "type": "string",
          "enum": ["engine_supported", "conceptual_only"]
        },
        "prerequisites": {
          "type": "array",
          "items": { "$ref": "#/definitions/idString" },
          "uniqueItems": true
        },
        "remediationLessonIds": {
          "type": "array",
          "items": { "$ref": "#/definitions/idString" },
          "uniqueItems": true
        }
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "tagSelectors", "difficulty"],
      "properties": {
        "id": { "$ref": "#/definitions/idString" },
        "title": { "$ref": "#/definitions/nonEmptyString" },
        "tagSelectors": {
          "type": "object",
          "description": "Opaque tag map used by clients for filtering and mastery aggregation.",
          "additionalProperties": {
            "type": "array",
            "items": { "$ref": "#/definitions/nonEmptyString" },
            "uniqueItems": true
          }
        },
        "difficulty": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      }
    },
    "milestoneGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "requiredObjectiveIds",
        "minDecisionSamples",
        "masteryThreshold",
        "criticalMistakeCap",
        "safetyCritical"
      ],
      "properties": {
        "id": { "$ref": "#/definitions/idString" },
        "title": { "$ref": "#/definitions/nonEmptyString" },
        "requiredObjectiveIds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/idString" },
          "uniqueItems": true
        },
        "minDecisionSamples": {
          "type": "integer",
          "minimum": 0
        },
        "masteryThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "criticalMistakeCap": {
          "type": "integer",
          "minimum": 0
        },
        "safetyCritical": {
          "type": "boolean"
        }
      }
    }
  }
}
