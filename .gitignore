# Secrets — never commit real keys
.env
.env.local
*.pem

# Firebase
.firebase/
firebase-debug.log
firebase-debug.*.log
ui-debug.log
functions/node_modules/
functions/lib/
tools/ui-agent-sdk/node_modules/
# Local Firebase app configs (API keys) — keep out of public repos
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
lib/firebase_options.dart

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local release binaries dropped in the repo root (e.g. flutter build apk
# with --build-name) must not dirty PRIMARY for ui/content agent loops.
*.apk
*.aab
*.ipa

# Agent throwaway probe tests (LPT-697 left _probe_*.dart on PRIMARY and
# wedged the ui-agent loop). Prefer ~/.live-poker-trainer/agent-probes/.
**/_probe_*.dart

# Python tooling
__pycache__/
.venv/

# Agent scratch screenshots live in .cursor/tmp/
.cursor/tmp-*
.cursor/tmp/

# Local agent plans (not product docs)
.cursor/plans/

# Feature worktrees created by the make-change skill
.worktrees/
tool/.env*
tool/.audio_candidates/
