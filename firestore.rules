rules_version = '2';

// ===============================================================
// Assumed data model
// ===============================================================
// users/{uid}
//   displayName: string, 1..18 characters
//   avatarRef: string, empty/builtin id/Firebase Storage HTTPS URL
//   createdAt: timestamp, immutable
//   updatedAt: timestamp
//   preferences: validated gameplay settings map
//
// users/{uid}/situationReceipts/{situationId}
//   Functions-only allocation and completion receipt
//
// users/{uid}/handHistory/{handId}
//   Functions-authored hand summary; owner-readable
//
// users/{uid}/progress/main
//   Functions-authored aggregates; owner-readable
//
// users/{uid}/course/main
//   Functions-authored course progress; owner-readable
//
// users/{uid}/courseAttempts/{attemptId}
//   Functions-authored lesson attempts; owner-readable
//
// users/{uid}/courseStepReceipts/{idempotencyKey}
//   Functions-only step receipts
//
// users/{uid}/courseReviews/{reviewId}
//   Functions-authored review schedule; owner-readable
//
// users/{uid}/courseXpLedger/{entryId}
//   Functions-authored XP audit; owner-readable
//
// users/{uid}/entitlements/liveTraining
//   Functions-authored Live Training entitlement; owner-readable
//
// courseTransferReceipts/{receiptId}
//   Admin-only anonymous→linked progress transfer receipts
//
// courseTombstones/{sourceUid}
//   Admin-only TTL queue for purged anonymous course trees
//
// appConfig/courseFlags
//   Server-controlled course feature flags; signed-in read-only
//
// tableSetups/{setupKey}/situations/{situationId}
//   Private server-generated pool; Admin SDK only
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isRecent(value) {
      return value is timestamp
        && value >= request.time - duration.value(5, 'm')
        && value <= request.time + duration.value(1, 'm');
    }

    function validDisplayName(value) {
      return value is string && value.size() >= 1 && value.size() <= 18;
    }

    function validAvatarRef(value) {
      return value is string
        && value.size() <= 2048
        && (
          value == ''
          || value.matches('^builtin:(spade|heart|diamond|club|chip|crown|button|star)$')
          || value.matches('^https://firebasestorage.googleapis.com/.*$')
        );
    }

    function validPreferences(value) {
      return value is map
        && value.keys().hasAll([
          'smallBlind',
          'bigBlind',
          'seatCount',
          'maxStackDepthBb',
          'chipDisplayMode',
          'lineupMode',
          'customArchetypes'
        ])
        && value.keys().hasOnly([
          'smallBlind',
          'bigBlind',
          'seatCount',
          'maxStackDepthBb',
          'chipDisplayMode',
          'lineupMode',
          'customArchetypes'
        ])
        && value.smallBlind is number
        && value.smallBlind > 0
        && value.smallBlind <= 100000
        && value.bigBlind is number
        && value.bigBlind >= value.smallBlind
        && value.bigBlind <= 200000
        && value.seatCount is int
        && value.seatCount >= 2
        && value.seatCount <= 9
        && value.maxStackDepthBb is int
        && value.maxStackDepthBb >= 20
        && value.maxStackDepthBb <= 500
        && value.chipDisplayMode is string
        && value.chipDisplayMode in ['dollars', 'bb', 'both']
        && value.lineupMode is string
        && value.lineupMode in ['randomPool', 'custom']
        && value.customArchetypes is string
        && value.customArchetypes.size() <= 160;
    }

    function validUser(data) {
      return data.keys().hasAll([
          'displayName',
          'avatarRef',
          'createdAt',
          'updatedAt',
          'preferences'
        ])
        && data.keys().hasOnly([
          'displayName',
          'avatarRef',
          'createdAt',
          'updatedAt',
          'preferences'
        ])
        && validDisplayName(data.displayName)
        && validAvatarRef(data.avatarRef)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && validPreferences(data.preferences);
    }

    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && validUser(request.resource.data)
        && isRecent(request.resource.data.createdAt)
        && isRecent(request.resource.data.updatedAt);

      allow update: if isOwner(uid)
        && validUser(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;

      match /situationReceipts/{situationId} {
        allow read, write: if false;
      }

      match /handHistory/{handId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /progress/{docId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /liveProgress/{docId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /liveActionFeed/{docId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /liveHandHistory/{handId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /liveHandReceipts/{handId} {
        allow read, write: if false;
      }

      match /liveSessions/{sessionId}/{document=**} {
        allow read, write: if false;
      }

      match /liveStartRequests/{requestId} {
        allow read, write: if false;
      }

      match /liveOpenSession/{docId} {
        allow read, write: if false;
      }

      match /course/{docId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /courseAttempts/{attemptId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /courseStepReceipts/{idempotencyKey} {
        allow read, write: if false;
      }

      match /courseReviews/{reviewId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /courseXpLedger/{entryId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /courseStartRequests/{requestId} {
        allow read, write: if false;
      }

      match /courseRateLimits/{bucket} {
        allow read, write: if false;
      }

      match /courseTransferMerges/{receiptId} {
        allow read, write: if false;
      }

      match /entitlements/{docId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /playedScenarios/{id} {
        allow read, write: if false;
      }

      match /mistakes/{id} {
        allow read, write: if false;
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /appConfig/{docId} {
      // Course feature flags are readable by any signed-in user (incl. anon).
      allow read: if signedIn() && docId == 'courseFlags';
      allow write: if false;
    }

    match /courseTransferReceipts/{receiptId} {
      allow read, write: if false;
    }

    match /courseTombstones/{sourceUid} {
      allow read, write: if false;
    }

    match /tableSetups/{setupKey} {
      allow read, write: if false;

      match /situations/{situationId} {
        allow read, write: if false;
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /liveTableSetups/{setupKey}/{document=**} {
      allow read, write: if false;
    }

    match /liveGenerationJobs/{jobId} {
      allow read, write: if false;
    }

    match /scenarios/{contentHash} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
