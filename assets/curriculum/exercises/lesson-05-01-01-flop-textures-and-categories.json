          "id": "c",
          "text": "9h 8h 7c"
        },
        {
          "id": "d",
          "text": "Qs Js Td"
        }
      ],
      "correctChoiceId": "a",
      "explanation": "Unpaired, rainbow, and disconnected boards change on fewer turns than monotone or connected boards."
    },
    {
      "id": "q2",
